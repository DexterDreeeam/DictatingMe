# Rust
/target

# Node / frontend
/node_modules
/dist
/release/

# Tauri
/runtime/target
/runtime/gen

# Runtime user data (dev-time local testing artifacts, never real user data)
/.dm-data/

# Models and acceptance assets: downloaded via assets/download-assets.ps1, never committed.
# Only the PowerShell download script is tracked inside the assets directory.
/assets/*
!/assets/download-assets.ps1
!/assets/sha.json
!/assets/manifest-cn.json
!/assets/assets-manifest.json
!/assets/run-package.ps1
!/assets/run-release.ps1
!/assets/run-release-install.ps1
!/assets/run-store-release.ps1

# Editor
.vscode/
.idea/
*.log

# 宣传片配音（edge-tts 合成，跑 brainstrom/make-promo-voice.cmd 可重新生成）
# 台词文本是脚本的输入，要跟仓库走
brainstrom/promo-voice/*
!brainstrom/promo-voice/lines/

# 宣传片分发包（跑 brainstrom/make-promo-kit.cmd 可重新生成）
brainstrom/promo-kit/
brainstrom/promo-kit.zip

# 宣传视频（跑 brainstrom/make-promo-video.cjs 可重新生成）
brainstrom/promo-video/
